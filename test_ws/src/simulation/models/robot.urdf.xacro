<?xml version="1.0"?>
<robot name="vehicle_blue" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- BASE -->
  <link name="base_link">

    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>

    <visual>
      <geometry>
        <box size="2 1 0.5"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <box size="2 1 0.5"/>
      </geometry>
    </collision>

  </link>

  <!-- LEFT WHEEL -->
  <link name="left_wheel">

    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>

  </link>

  <!-- RIGHT WHEEL -->
  <link name="right_wheel">

    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>

  </link>

  <!-- JOINTS -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.5 0.6 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.5 -0.6 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- GAZEBO DIFF DRIVE -->
  <gazebo>
    <plugin name="diff_drive" filename="gz-sim-diff-drive-system">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>1.2</wheel_separation>
      <wheel_radius>0.4</wheel_radius>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
    </plugin>
  </gazebo>

</robot>